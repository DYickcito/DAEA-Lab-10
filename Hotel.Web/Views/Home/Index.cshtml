@{
    ViewData["Title"] = "Inicio";
}

<div class="hero-section">
    <h1><i class="bi bi-building me-2"></i>Gran Hotel Continental</h1>
    <p class="mb-0">Sistema de Gestión Hotelera — Bienvenido al panel de administración</p>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <i class="bi bi-door-open" style="font-size:2.5rem; color:var(--azul-slate);"></i>
                <h5 class="mt-3 mb-2 fw-bold">Habitaciones</h5>
                <p class="text-muted small">Gestiona el inventario de habitaciones: creación, edición y baja lógica.</p>
                <a asp-controller="Habitaciones" asp-action="Index" class="btn btn-hotel-primary mt-2">
                    <i class="bi bi-arrow-right-circle me-1"></i>Ver Habitaciones
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <i class="bi bi-search" style="font-size:2.5rem; color:var(--azul-slate);"></i>
                <h5 class="mt-3 mb-2 fw-bold">Disponibilidad</h5>
                <p class="text-muted small">Consulta qué habitaciones están libres para un rango de fechas con precio estimado.</p>
                <a asp-controller="Reservas" asp-action="Disponibles" class="btn btn-hotel-primary mt-2">
                    <i class="bi bi-arrow-right-circle me-1"></i>Buscar Disponibilidad
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <i class="bi bi-calendar-check" style="font-size:2.5rem; color:var(--azul-slate);"></i>
                <h5 class="mt-3 mb-2 fw-bold">Reservas</h5>
                <p class="text-muted small">Administra las reservas activas, confirma cancelaciones y registra nuevos huéspedes.</p>
                <a asp-controller="Reservas" asp-action="Index" class="btn btn-hotel-primary mt-2">
                    <i class="bi bi-arrow-right-circle me-1"></i>Ver Reservas
                </a>
            </div>
        </div>
    </div>
</div>
