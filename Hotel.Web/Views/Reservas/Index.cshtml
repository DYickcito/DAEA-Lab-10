@model IEnumerable<Hotel.Web.Models.Reserva>
@{
    ViewData["Title"] = "Reservas";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h1><i class="bi bi-calendar-check me-2"></i>Reservas</h1>
    <a class="btn btn-hotel-gold" asp-action="Create">
        <i class="bi bi-plus-circle me-1"></i>Nueva Reserva
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info d-flex align-items-center gap-2">
        <i class="bi bi-info-circle-fill"></i>
        <span>No hay reservas registradas.</span>
    </div>
}
else
{
    <div class="table-hotel">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Huésped</th>
                    <th>Habitación</th>
                    <th>Ingreso</th>
                    <th>Salida</th>
                    <th class="text-center">Noches</th>
                    <th class="text-end">Total est.</th>
                    <th class="text-center">Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    var noches = r.FechaSalida.DayNumber - r.FechaIngreso.DayNumber;
                    var total = noches * r.IdHabitacionNavigation.IdTipoHabitacionNavigation.PrecioNoche;
                    <tr>
                        <td class="text-muted small">@r.IdReserva</td>
                        <td>
                            <span class="fw-semibold">@r.IdHuespedNavigation.Apellidos</span>,
                            @r.IdHuespedNavigation.Nombres
                        </td>
                        <td>
                            Hab. <strong>@r.IdHabitacionNavigation.Numero</strong>
                            <span class="text-muted small d-block">@r.IdHabitacionNavigation.IdTipoHabitacionNavigation.Nombre</span>
                        </td>
                        <td>@r.FechaIngreso.ToString("dd/MM/yyyy")</td>
                        <td>@r.FechaSalida.ToString("dd/MM/yyyy")</td>
                        <td class="text-center">@noches</td>
                        <td class="text-end fw-semibold">S/ @total.ToString("N2")</td>
                        <td class="text-center">
                            @switch (r.Estado)
                            {
                                case "Pendiente":
                                    <span class="badge-pendiente">Pendiente</span>
                                    break;
                                case "Confirmada":
                                    <span class="badge-confirmada">Confirmada</span>
                                    break;
                                case "Cancelada":
                                    <span class="badge-cancelada">Cancelada</span>
                                    break;
                                default:
                                    <span class="badge-finalizada">Finalizada</span>
                                    break;
                            }
                        </td>
                        <td class="text-end">
                            @if (r.Estado == "Pendiente" || r.Estado == "Confirmada")
                            {
                                <form asp-action="Cancelar" method="post" class="d-inline"
                                      onsubmit="return confirm('¿Confirma la cancelación de esta reserva?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.IdReserva" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-x-circle me-1"></i>Cancelar
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
