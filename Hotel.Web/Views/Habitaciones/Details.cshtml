@model Hotel.Web.Models.Habitacion
@{
    ViewData["Title"] = "Detalle de Habitación";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h1><i class="bi bi-info-circle me-2"></i>Habitación @Model.Numero</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header-hotel">
                <i class="bi bi-door-open me-2"></i>Información Detallada
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted">Número</dt>
                    <dd class="col-sm-7 fw-bold fs-5">@Model.Numero</dd>

                    <dt class="col-sm-5 text-muted">Piso</dt>
                    <dd class="col-sm-7">@Model.Piso</dd>

                    <dt class="col-sm-5 text-muted">Tipo</dt>
                    <dd class="col-sm-7">@Model.IdTipoHabitacionNavigation.Nombre</dd>

                    <dt class="col-sm-5 text-muted">Capacidad</dt>
                    <dd class="col-sm-7">@Model.IdTipoHabitacionNavigation.Capacidad persona(s)</dd>

                    <dt class="col-sm-5 text-muted">Precio / noche</dt>
                    <dd class="col-sm-7 fw-bold" style="color:var(--azul-slate);">S/ @Model.IdTipoHabitacionNavigation.PrecioNoche.ToString("N2")</dd>
                </dl>
            </div>
            <div class="card-footer bg-white border-0 d-flex gap-2 px-4 pb-4">
                <a asp-action="Edit" asp-route-id="@Model.IdHabitacion" class="btn btn-hotel-primary">
                    <i class="bi bi-pencil me-1"></i>Editar
                </a>
                <a asp-action="Delete" asp-route-id="@Model.IdHabitacion" class="btn btn-outline-danger">
                    <i class="bi bi-trash me-1"></i>Dar de baja
                </a>
            </div>
        </div>
    </div>
</div>
