@model Hotel.Web.Models.Habitacion
@{
    ViewData["Title"] = "Dar de Baja Habitación";
}

<div class="page-header">
    <h1><i class="bi bi-exclamation-triangle me-2 text-danger"></i>Confirmar Baja</h1>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger">
            <div class="card-header" style="background:#fee2e2; color:#991b1b;">
                <i class="bi bi-trash me-2"></i>Eliminar Habitación (Baja Lógica)
            </div>
            <div class="card-body p-4">
                <p class="text-muted mb-3">¿Está seguro de dar de baja la siguiente habitación? El registro se conservará como inactivo.</p>
                <dl class="row mb-0">
                    <dt class="col-sm-5">Número</dt>
                    <dd class="col-sm-7 fw-bold">@Model.Numero</dd>
                    <dt class="col-sm-5">Piso</dt>
                    <dd class="col-sm-7">@Model.Piso</dd>
                    <dt class="col-sm-5">Tipo</dt>
                    <dd class="col-sm-7">@Model.IdTipoHabitacionNavigation.Nombre</dd>
                </dl>
            </div>
            <div class="card-footer bg-white border-0 d-flex gap-2 px-4 pb-4">
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="IdHabitacion" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Confirmar Baja
                    </button>
                </form>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>Cancelar
                </a>
            </div>
        </div>
    </div>
</div>
